# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# Never commit .env.local - it holds real secrets.

# ---------------------------------------------------------------
# Convex  (both values are written automatically by `npx convex dev`)
# ---------------------------------------------------------------
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ---------------------------------------------------------------
# Clerk  (Clerk Dashboard -> Configure -> API Keys)
# ---------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------
# Used inside Convex functions (convex/http.ts, convex/openai.ts).
# Convex functions do NOT read this file - set these in the Convex
# deployment too:
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_...
#   npx convex env set OPENAI_API_KEY sk-...
# ---------------------------------------------------------------
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
